{
  "name": "@mdview/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared rendering core: markdown, code, Mermaid viewer and editor. Runs in WKWebView (macOS) and Chromium (Linux).",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "npm run typecheck && node test/interactions.mjs && node test/interactions.mjs --engine chromium && node test/corpus.mjs --engine webkit,chromium",
    "test:interactions": "node test/interactions.mjs",
    "test:corpus": "node test/corpus.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@replit/codemirror-vim": "6.4.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "codemirror-lang-mermaid": "0.5.0",
    "dompurify": "3.4.16",
    "js-yaml": "5.4.2",
    "markdown-it": "14.3.2",
    "markdown-it-footnote": "4.0.0",
    "mermaid": "12.1.0",
    "morphdom": "2.7.8",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "esbuild": "0.28.2",
    "playwright": "^1.60.0",
    "typescript": "6.0.3"
  }
}
