{
  "name": "mdview",
  "productName": "MDView",
  "version": "1.0.0",
  "private": true,
  "description": "A Mermaid-first markdown previewer for project docs written by agents.",
  "author": "Yvan Guekeng <yvan.guekeng@gmail.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/gtindo/md-viewer",
  "main": "dist/main.js",
  "desktopName": "mdview.desktop",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "start": "npm run build && electron .",
    "test": "npm run typecheck && node test/unit.mjs && node test/e2e.mjs",
    "test:unit": "node test/unit.mjs",
    "test:e2e": "node test/e2e.mjs",
    "dist": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@parcel/watcher": "2.6.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/node": "24.19.1",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "playwright": "1.60.0",
    "typescript": "6.0.3"
  }
}
